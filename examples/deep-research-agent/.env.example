# ─── Required ────────────────────────────────────────────────
# LLM provider API key.
OPENAI_API_KEY=sk-...

# ─── Optional: models per phase ──────────────────────────────
# Each phase can run on a different model — scoping is cheap, writing is not.
# LLM_PROVIDER=openai
# LLM_MODEL_SCOPE=gpt-4o-mini
# LLM_MODEL_RESEARCHER=gpt-4o-mini
# LLM_MODEL_WRITER=gpt-4o

# ─── Optional: web search backend ────────────────────────────
# Default is the offline mock corpus in tools.py — no key needed.
# Set SEARCH_BACKEND and the matching key to hit a real engine.
# SEARCH_BACKEND=mock          # mock | tavily | brave | serper
# TAVILY_API_KEY=tvly-...
# BRAVE_SEARCH_API_KEY=BSA...
# SERPER_API_KEY=...
# SEARCH_TOP_K=5
# FETCH_MAX_CHARS=20000
# RESEARCH_TOOL_BUDGET=12

# ─── Optional: learned memory (see ../learning-loop) ─────────
# DEEP_RESEARCH_DISABLE_LEARNED_MEMORY=1
# DEEP_RESEARCH_MAX_LEARNED_FACTS=10

# ─── Optional: FastAIAgent control plane ─────────────────────
# FASTAIAGENT_API_KEY=fa_k_your_key_here
# FASTAIAGENT_TARGET=https://app.fastaiagent.net
# FASTAIAGENT_PROJECT=deep-research
