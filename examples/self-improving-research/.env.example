# ─── Required ────────────────────────────────────────────────
# LLM provider API key. This template wraps ../deep-research-agent, so its
# own .env.example applies too if you switch on a real search backend.
OPENAI_API_KEY=sk-...

# ─── Optional: models ────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# The fact extractor that closes the loop between runs.
# LLM_MODEL_EXTRACTOR=gpt-4o-mini
