# ─── Required ────────────────────────────────────────────────
# LLM provider API key — the loop needs a model twice: once to run the
# agent, once to extract durable facts from the traces it left behind.
OPENAI_API_KEY=sk-...

# ─── Optional: models ────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# The extractor reads whole traces; a cheaper model is usually enough.
# LLM_MODEL_EXTRACTOR=gpt-4o-mini
